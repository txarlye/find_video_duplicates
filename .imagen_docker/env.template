# ========================================
# .env — variables para docker-compose-synology.yml
# ========================================
#
# Copia este archivo a ".env", en la MISMA carpeta donde quede el
# docker-compose.yml (p.ej. el proyecto de Container Manager/Portainer),
# y rellena rutas + secretos aquí — un único fichero para todo. Nunca
# se sube a git (docker/.env está en .gitignore).

# Puerto en el host para la app (por defecto 8000)
API_PORT=8000

# IP de Tailscale del host, para restringir el acceso a tu tailnet en
# vez de exponerlo en toda la LAN. Vacío = solo localhost (127.0.0.1).
TAILSCALE_IP=

# RUTAS DEL SISTEMA (carpetas reales en tu Synology)
MOVIES_PATH=/ruta/a/tus/peliculas
PLEX_DB_PATH=/ruta/a/la/carpeta/con/com.plexapp.plugins.library.db
DATA_PATH=./data
LOGS_PATH=./logs
SCAN_DATA_PATH=./scan_data

# Zona horaria (para que la hora del programador interno de Propuestas
# coincida con tu hora real). Por defecto Europe/Madrid.
TZ=Europe/Madrid

# ========================================
# Secretos de la app — todo esto es opcional, lo que dejes vacío
# simplemente no se activa.
# ========================================

# API Key de IMDB (obtener en https://imdb-api.com/api)
IMDB_API_KEY=

# API Key de OMDb (gratis en https://www.omdbapi.com/apikey.aspx)
# Contrasta las sugerencias de nombre de la IA (detector de huérfanos)
# contra una base de datos real en vez de fiarse solo de la memoria del
# modelo. Sin esto, la IA sigue funcionando pero sin contrastar el año.
OMDB_API_KEY=

# API Key de TMDB (gratis en https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Telegram (obtener el bot token de @BotFather)
# El bot solo sirve para archivos de hasta 50MB (límite real del Bot API
# de Telegram). Para archivos más grandes hace falta además rellenar
# TELEGRAM_API_ID/HASH/PHONE de abajo (Telethon, con tu cuenta personal).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Solo si eliges OpenAI o Gemini como proveedor de IA para nombres de
# huérfanos (Ollama en local no necesita ninguna de las dos)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email de aviso de "Propuestas" (⚙️ Configuración → 📅 Programación).
# SMTP_USER: tu email completo, con @gmail.com incluido.
# SMTP_PASSWORD: con Gmail, tiene que ser una "contraseña de aplicación"
# de 16 caracteres (myaccount.google.com/apppasswords) — tu contraseña
# normal de Gmail NO funciona aquí, da error de credenciales.
# El destinatario y el resto de opciones se configuran desde la propia app.
SMTP_USER=
SMTP_PASSWORD=
# Solo si no usas Gmail (por defecto smtp.gmail.com:587)
SMTP_HOST=
SMTP_PORT=

# Solo si quieres el botón "Crear tarea en el Planificador de Synology"
# (⚙️ Configuración → 📅 Programación) — crea la tarea programada
# externa directamente en tu DSM, sin tener que hacerlo a mano.
# SYNOLOGY_USER debe ser un usuario DEDICADO y RESTRINGIDO (grupo
# administrators, requisito de la propia API de DSM), nunca tu cuenta
# de administrador principal: es la única credencial de esta app con
# alcance de administrador sobre el NAS. El programador interno de la
# app (sin nada de esto) ya cubre el mismo caso de uso sin necesitar
# ningún acceso al NAS — esto es solo para quien prefiera la redundancia
# de una tarea externa que no dependa de que el contenedor siga vivo.
SYNOLOGY_HOST=
SYNOLOGY_PORT=5001
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
