# ========================================
# docker/.env — variables para docker-compose-synology.yml
# ========================================
#
# Copia este archivo a docker/.env (NO al .env de la raíz del repo —
# ese es otro, para los secretos de la app, ver más abajo) y ajusta las
# rutas a tu Synology.
#
# IMPORTANTE: docker/.env está en .gitignore, no se sube a Git.

# Puerto en el host para la app (por defecto 8000)
API_PORT=8000

# IP de Tailscale del host, para restringir el acceso a tu tailnet en
# vez de exponerlo en toda la LAN. Vacío = solo localhost (127.0.0.1).
TAILSCALE_IP=

# RUTAS DEL SISTEMA (carpetas reales en tu Synology)
MOVIES_PATH=/ruta/a/tus/peliculas
PLEX_DB_PATH=/ruta/a/la/carpeta/con/com.plexapp.plugins.library.db
DATA_PATH=./data
LOGS_PATH=./logs
SCAN_DATA_PATH=./scan_data

# Zona horaria (para que la hora del programador interno de Propuestas
# coincida con tu hora real). Por defecto Europe/Madrid.
TZ=Europe/Madrid

# ========================================
# Los secretos (TELEGRAM_BOT_TOKEN, OMDB_API_KEY, TMDB_API_KEY,
# IMDB_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY...) NO van aquí — van en
# el .env de la raíz del repo (copia .env.example a .env y rellénalo),
# que docker-compose inyecta directamente dentro del contenedor.
# ========================================
