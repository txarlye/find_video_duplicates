{
    "app": {
        "name": "Detector de Películas Duplicadas",
        "version": "1.0.0",
        "debug": false
    },
    "paths": {
        "last_scan_path": "",
        "last_output_path": "",
        "default_scan_path": "",
        "debug_folder": "",
        "movies_folder": "",
        "selected_movies_folder": ""
    },
    "detection": {
        "similarity_threshold": 0.8,
        "duration_filter_enabled": true,
        "duration_tolerance_minutes": 5,
        "excluded_directories": [
            "debug",
            "00-borrar",
            "temp",
            "temporary",
            "backup",
            "backups"
        ],
        "supported_extensions": [
            ".mp4",
            ".avi",
            ".mkv",
            ".mov",
            ".wmv",
            ".flv",
            ".m4v",
            ".mpg",
            ".mpeg",
            ".3gp",
            ".webm"
        ]
    },
    "imdb": {
        "api_key": "",
        "base_url": "https://imdb-api.com",
        "language": "es"
    },
    "telegram": {
        "bot_token": "",
        "channel_id": "",
        "max_file_size": 2000000000,
        "upload_delay": 1
    },
    "ui": {
        "theme": "light",
        "page_size": 20,
        "show_advanced_options": false,
        "show_video_players": true,
        "video_player_size": "medium",
        "show_embedded_players": false,
        "video_start_time_seconds": 360
    },
    "debug": {
        "enabled": true
    },
    "plex": {
        "database_path": "",
        "libraries": {
            "movies": "Películas",
            "tv_shows": "Series"
        },
        "fetch_metadata": true,
        "duration_filter_enabled": true,
        "duration_tolerance_minutes": 5,
        "hash_calculation_enabled": false,
        "hash_calculation_warning": "⚠️ El cálculo de hash puede tardar 5+ minutos para archivos grandes"
    },
    "runtime": {
        "total_pairs": 0,
        "pairs_deleted": 0
    },
    "ai": {
        "enabled": false,
        "provider": "ollama",
        "mode": "suggest",
        "ollama_url": "http://localhost:11434",
        "ollama_model": "qwen2.5:7b",
        "openai_model": "gpt-4o-mini",
        "gemini_model": "gemini-1.5-flash"
    }
}
